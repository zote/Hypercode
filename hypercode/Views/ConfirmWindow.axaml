<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hypercode.Views"
        x:Class="Hypercode.Views.ConfirmWindow"
        Title="Confirmar"
        Width="540" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.Window}">

  <!-- Layout de diálogo da HIG (Styles/Dialog.axaml): título, detalhe e botões à direita,
       Cancelar à esquerda do botão que confirma. -->
  <views:DialogFrame Name="Frame">
    <Border Name="BodyBox" BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Separator}"
            Background="{DynamicResource Brush.Background.Content}"
            CornerRadius="{DynamicResource Radius.Control}"
            Padding="{DynamicResource Padding.Box}">
      <ScrollViewer MaxHeight="{DynamicResource Size.DialogDetail.MaxHeight}">
        <TextBlock Name="BodyText" Classes="callout mono" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Label.Primary}" />
      </ScrollViewer>
    </Border>

    <views:DialogFrame.Buttons>
      <Button Name="CancelButton" Content="Cancelar" Click="OnCancel" IsCancel="True" />
      <Button Name="ConfirmButton" Content="Confirmar" Click="OnConfirm" IsDefault="True" />
    </views:DialogFrame.Buttons>
  </views:DialogFrame>
</Window>
