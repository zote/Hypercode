<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hypercode.Views"
        x:Class="Hypercode.Views.MainWindow"
        Title="Hypercode — Git Worktrees"
        Width="1180" Height="640"
        MinWidth="860" MinHeight="400"
        DragDrop.AllowDrop="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome, OSXThickTitleBar"
        Background="{DynamicResource Brush.Background.Window}">

  <Window.Styles>
    <!-- Com a barra de título estendida, as abas começam depois dos botões de janela e sobem
         para a altura deles; em tela cheia os botões somem, e o recuo junto (classe posta pelo
         code-behind). O Padding fica só no estilo: valor local no Border venceria o .extended. -->
    <Style Selector="Border#TabStripBar">
      <Setter Property="Padding" Value="{DynamicResource Padding.TabStrip}" />
    </Style>
    <Style Selector="Border#TabStripBar.extended">
      <Setter Property="Padding" Value="{DynamicResource Padding.TabStrip.Extended}" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Label.Secondary}" />
    </Style>

    <!-- Cabeçalho clicável da tabela: ordena pela coluna. Sem fundo nem borda, para parecer
         texto; o rótulo acende sob o mouse. -->
    <Style Selector="Button.header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Subheadline}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Label.Secondary}" />
    </Style>
    <Style Selector="Button.header:pointerover /template/ ContentPresenter, Button.header:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Label.Primary}" />
    </Style>

    <!-- Linha da tabela de worktrees: duas linhas de texto (nome e etiquetas). -->
    <Style Selector="ListBox.table ListBoxItem">
      <Setter Property="Padding" Value="{DynamicResource Padding.TableCell}" />
      <Setter Property="MinHeight" Value="{DynamicResource Size.TableRow.TwoLine}" />
    </Style>

    <!-- Cor da etiqueta de estado (BadgeTemplate). Fica em estilo, e não no PathIcon, para a
         linha selecionada poder trocá-la: valor local venceria qualquer estilo. -->
    <Style Selector="PathIcon.badge">
      <Setter Property="Foreground">
        <MultiBinding Converter="{x:Static views:BadgeBrushConverter.Instance}">
          <Binding Path="BrushKey" />
          <Binding Path="ActualThemeVariant" RelativeSource="{RelativeSource Self}" />
        </MultiBinding>
      </Setter>
    </Style>
    <!-- Na linha selecionada a etiqueta toma a cor do texto da seleção, como os ícones do
         Finder: sobre a accent nenhum tom do Primer passa em 3:1, e sobre o cinza da seleção
         inativa o Danger escuro dá 2,8:1 (#108). O tooltip continua dizendo o estado. -->
    <Style Selector="ListBox.table ListBoxItem:selected PathIcon.badge">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Label.Primary}" />
    </Style>
    <Style Selector="ListBox.table:focus-within ListBoxItem:selected PathIcon.badge">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    </Style>

    <!-- Abas: a selecionada tem o fundo do conteúdo e se encaixa nele; as outras ficam no
         fundo da janela, com um realce discreto sob o mouse. -->
    <Style Selector="ListBox.tabs">
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem">
      <Setter Property="Padding" Value="{DynamicResource Padding.Tab}" />
      <Setter Property="MinHeight" Value="{DynamicResource Size.Tab.MinHeight}" />
      <Setter Property="Margin" Value="{DynamicResource Margin.Tab}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tab}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Label.Secondary}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Label.Quaternary}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Label.Primary}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Background.Content}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Label.Primary}" />
    </Style>

    <!-- × da aba: discreto até o mouse passar. -->
    <Style Selector="Button.tabclose">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Label.Tertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Label.Primary}" />
    </Style>

    <!-- Aviso do rodapé (cota do GitHub, FSEvents): texto de aviso, menor que o status. -->
    <Style Selector="TextBlock.notice">
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Subheadline}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Warning}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <DataTemplate x:Key="BadgeTemplate">
      <!-- O Border transparente faz o tooltip responder na caixa toda, não só no traço do
           ícone. O PathIcon desenha no quadro 16x16 do Octicon (Styles/Controls.axaml). -->
      <Border Margin="{DynamicResource Margin.Badge}" Background="Transparent" ToolTip.Tip="{Binding Tooltip}">
        <PathIcon Classes="badge" Data="{Binding IconKey, Converter={x:Static views:BadgeConverter.ToGeometry}}" />
      </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="BadgeRowPanel">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*">

    <!-- Abas: um repositório por aba, todos monitorados. Arrastar reordena; ⌘1…⌘9 trocam.
         A faixa ocupa a barra de título (#91), com os botões de janela à esquerda: arrastar a
         área vazia move a janela e o duplo-clique faz o que Ajustes do Sistema manda. O fundo
         transparente é o que deixa a área vazia receber o clique. -->
    <Border Name="TabStripBar" Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Separator}"
            Background="Transparent">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal">
            <ListBox Name="TabStrip" Classes="tabs"
                     ItemsSource="{Binding Repositories}"
                     SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"
                     SelectionMode="Single">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.Label}" Background="Transparent"
                              VerticalAlignment="Center" ToolTip.Tip="{Binding TabToolTip}">
                    <StackPanel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Configurações deste repositório…" Click="OnTabSettingsClick" />
                        <MenuItem Header="Revelar no Finder" Click="OnTabRevealClick" />
                        <Separator />
                        <MenuItem Header="Fechar a aba…" Click="OnTabCloseClick" />
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                    <TextBlock Classes="body emphasized" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                    <TextBlock Classes="subheadline muted" VerticalAlignment="Center" Text="{Binding WorktreeCount}" />
                    <ContentControl VerticalAlignment="Center"
                                    Content="{Binding FailingBadge}" ContentTemplate="{StaticResource BadgeTemplate}"
                                    IsVisible="{Binding HasFailingChecks}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding HasCompleted}">
                      <ContentControl Content="{Binding CompletedBadge}" ContentTemplate="{StaticResource BadgeTemplate}" />
                      <!-- Margem negativa: cola a contagem no ícone, desfazendo parte do
                           Margin.Badge que separa uma etiqueta da seguinte. -->
                      <TextBlock Classes="subheadline" VerticalAlignment="Center" Margin="-3,0,0,0" Text="{Binding CompletedCount}"
                                 ToolTip.Tip="{Binding CompletedBadge.Tooltip}" />
                    </StackPanel>
                    <ContentControl VerticalAlignment="Center"
                                    Content="{Binding UnseenBadge}" ContentTemplate="{StaticResource BadgeTemplate}"
                                    IsVisible="{Binding HasUnseenChanges}" />
                    <Button Classes="borderless tabclose" Click="OnTabCloseClick"
                            ToolTip.Tip="Fechar a aba (⌘W). Nada no disco é apagado.">
                      <PathIcon Classes="small" Data="{StaticResource Icon.Close}" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Classes="borderless" VerticalAlignment="Center" Click="OnAddRepositoryClick" HotKey="Cmd+O"
                    ToolTip.Tip="Abrir um repositório numa aba nova (⌘O). Também dá para arrastar a pasta do Finder para a janela.">
              <PathIcon Data="{StaticResource Icon.Plus}" />
            </Button>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    Spacing="{DynamicResource Spacing.Related}">
          <Button Content="Atualizar"
                  Click="OnRefreshClick" IsEnabled="{Binding SelectedRepository.IsNotBusy, FallbackValue=False}" HotKey="Cmd+R"
                  ToolTip.Tip="Relê tudo da aba, inclusive os PRs (⌘R). Worktree criado ou apagado fora do app e commit, fetch ou push já aparecem sozinhos." />
          <Button Name="ActionsToggle" Classes="borderless" Click="OnToggleActionsPanelClick"
                  ToolTip.Tip="Fila do GitHub Actions (⇧⌘A): os runners da organização, o que cada um roda e a ordem estimada do que espera, nos repositórios escolhidos nas configurações">
            <PathIcon Data="{StaticResource Icon.Columns}" />
          </Button>
          <Button Classes="borderless" Click="OnHelpClick"
                  ToolTip.Tip="O que significam as etiquetas, a coluna PR, as abas e a limpeza">
            <PathIcon Data="{StaticResource Icon.Help}" />
          </Button>
          <!-- O ⌘, fica no item do menu do app: um HotKey aqui dispararia junto com ele. -->
          <Button Classes="borderless" Click="OnSettingsClick"
                  ToolTip.Tip="Configurações, globais ou de um repositório: comando, monitoramento, atribuição de issue, limpeza automática (⌘,)">
            <PathIcon Data="{StaticResource Icon.Settings}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Abaixo das abas: o repositório da frente e, à direita, o painel da fila do Actions. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

    <!-- Sem aba nenhuma -->
    <StackPanel Grid.Column="0" IsVisible="{Binding HasNoRepositories}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource Space.M}">
      <TextBlock Classes="title2" Text="Nenhum repositório aberto" HorizontalAlignment="Center" />
      <TextBlock Classes="body muted" HorizontalAlignment="Center" TextAlignment="Center"
                 Text="Abra um repositório git pela aba +, pelo ⌘O ou arrastando a pasta do Finder para cá.&#10;Cada repositório ganha a sua aba e continua monitorado em segundo plano." />
      <Button Content="Abrir repositório…" IsDefault="True" HorizontalAlignment="Center" Click="OnAddRepositoryClick" />
    </StackPanel>

    <!-- A aba da frente: tudo daqui para baixo é do repositório selecionado. -->
    <!-- Fundo de conteúdo, o mesmo da aba selecionada: a aba se encaixa nele. -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto"
          Background="{DynamicResource Brush.Background.Content}"
          DataContext="{Binding SelectedRepository}"
          IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">

    <!-- Filtro e criação -->
    <!-- 320: largura do filtro, layout desta barra. -->
    <Grid Grid.Row="0" ColumnDefinitions="320,Auto,*,Auto" Margin="{DynamicResource Padding.Bar}">
      <TextBox Grid.Column="0" Name="FilterBox"
               Text="{Binding FilterText, Mode=TwoWay}"
               Watermark="Filtrar por worktree, branch ou PR  (⌘F)"
               KeyDown="OnFilterKeyDown">
        <TextBox.InnerRightContent>
          <Button Classes="clear" Click="OnClearFilterClick"
                  IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  AutomationProperties.Name="Limpar o filtro"
                  ToolTip.Tip="Limpar o filtro (Esc)">
            <PathIcon Data="{StaticResource Icon.ClearField}" />
          </Button>
        </TextBox.InnerRightContent>
      </TextBox>
      <TextBlock Grid.Column="1" Classes="callout muted" VerticalAlignment="Center" Margin="{DynamicResource Margin.AfterField}"
                 Text="{Binding FilterSummary}" IsVisible="{Binding HasHiddenRows}" />
      <Button Grid.Column="3" Content="Novo worktree…" Click="OnCreateWorktreeClick"
              IsEnabled="{Binding CanCreateWorktree}" HotKey="Cmd+N"
              ToolTip.Tip="Cria um worktree com branch nova, a partir de um PR ou de uma issue (⌘N)" />
    </Grid>

    <!-- Cabeçalho da lista: clicar ordena; clicar de novo inverte -->
    <!-- As larguras de coluna (2.8*, 2.2*, 162, 2.4*) e a calha de 94 dos ícones (quatro) são o layout
         desta tabela, repetido nas linhas abaixo; não são tokens. -->
    <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Separator}"
            Padding="{DynamicResource Padding.TableHeader}">
      <Grid ColumnDefinitions="2.8*,2.2*,162,2.4*">
        <Button Grid.Column="0" Classes="header" Margin="94,0,0,0" Click="OnSortClick" Tag="Name">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
            <TextBlock Text="Worktree" />
            <PathIcon Classes="small" Data="{Binding NameSortIcon, Converter={x:Static views:BadgeConverter.ToGeometry}}"
                      IsVisible="{Binding NameSortIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="header" Click="OnSortClick" Tag="Branch">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
            <TextBlock Text="Branch" />
            <PathIcon Classes="small" Data="{Binding BranchSortIcon, Converter={x:Static views:BadgeConverter.ToGeometry}}"
                      IsVisible="{Binding BranchSortIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="header" Click="OnSortClick" Tag="PullRequest">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
            <TextBlock Text="PR" />
            <PathIcon Classes="small" Data="{Binding PullRequestSortIcon, Converter={x:Static views:BadgeConverter.ToGeometry}}"
                      IsVisible="{Binding PullRequestSortIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="header" Click="OnSortClick" Tag="Path">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
            <TextBlock Text="Caminho" />
            <PathIcon Classes="small" Data="{Binding PathSortIcon, Converter={x:Static views:BadgeConverter.ToGeometry}}"
                      IsVisible="{Binding PathSortIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Lista de worktrees -->
    <ListBox Grid.Row="2" Name="WorktreeList" Classes="table"
             ItemsSource="{Binding VisibleWorktrees}"
             SelectionMode="Multiple"
             SelectedItems="{Binding SelectedWorktrees}"
             KeyDown="OnListKeyDown">
      <!-- Um menu só, para a lista inteira: age sobre todas as linhas selecionadas. O clique
           direito numa linha fora da seleção seleciona só ela (o ListBox faz isso), e o
           Opening põe a contagem nos rótulos e habilita o que ao menos uma linha suporta. -->
      <ListBox.ContextMenu>
        <ContextMenu Opening="OnListContextMenuOpening">
          <MenuItem Name="FocusTerminalMenuItem" Click="OnFocusTerminalMenuClick"
                    ToolTip.Tip="Traz para a frente a sessão do iTerm2 ou do Terminal aberta neste worktree — a mais recente, se houver várias. É o que o duplo-clique faz quando há uma." />
          <MenuItem Name="LaunchMenuItem" Click="OnOpenTerminalMenuClick"
                    ToolTip.Tip="Abre uma janela nova, mesmo que já haja terminal aberto aqui." />
          <MenuItem Name="ShellMenuItem" Click="OnOpenShellMenuClick"
                    ToolTip.Tip="Abre o terminal na pasta do worktree, sem rodar o comando." />
          <MenuItem Name="ResumeClaudeMenuItem" Click="OnResumeClaudeMenuClick"
                    ToolTip.Tip="Abre o terminal rodando claude --continue: volta à última conversa deste worktree." />
          <Separator />
          <MenuItem Name="RevealMenuItem" Click="OnRevealMenuClick" />
          <MenuItem Name="OpenPullRequestMenuItem" Click="OnOpenPullRequestMenuClick" />
          <MenuItem Name="MarkSeenMenuItem" Click="OnMarkSeenMenuClick"
                    ToolTip.Tip="Tira o sino da linha: as mudanças do PR avisadas pelo monitoramento ficam como vistas. Abrir o PR no navegador faz o mesmo." />
          <MenuItem Name="RerunFailedChecksMenuItem" Click="OnRerunFailedChecksMenuClick"
                    ToolTip.Tip="gh run rerun --failed em cada workflow run do GitHub Actions com job falho no último commit do PR: só os jobs que falharam voltam para a fila. Check de CI externo (status commit) não é reexecutado." />
          <Separator />
          <MenuItem Name="UpdateBranchMenuItem" Click="OnUpdateBranchMenuClick"
                    ToolTip.Tip="git pull --ff-only: traz os commits do upstream da própria branch. Se a branch divergiu, o git recusa e nada muda. Não traz a base do PR." />
          <MenuItem Name="UpdateFromBaseMenuItem" Click="OnUpdateFromBaseMenuClick"
                    ToolTip.Tip="Faz fetch da base do PR e a traz para dentro da branch, com merge ou rebase — você escolhe na hora. É o que resolve o ícone de base desatualizada. Uma linha por vez." />
          <MenuItem Name="LockMenuItem" Click="OnLockMenuClick"
                    ToolTip.Tip="git worktree lock, com um motivo opcional: o git passa a recusar remover e podar o worktree, e a limpeza o ignora." />
          <MenuItem Name="UnlockMenuItem" Click="OnUnlockMenuClick"
                    ToolTip.Tip="git worktree unlock, depois de mostrar o worktree e a trava. Uma linha por vez." />
          <MenuItem Name="RemoveMenuItem" Click="OnRemoveWorktreeMenuClick"
                    ToolTip.Tip="git worktree remove, com confirmação. A branch local não é tocada." />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="2.8*,2.2*,162,2.4*"
                Background="Transparent"
                DoubleTapped="OnRowDoubleTapped">
            <Grid Grid.Column="0" ColumnDefinitions="94,*">
              <!-- Calha de largura fixa: os ícones ficam colados no nome e os nomes
                   continuam alinhados entre linhas com quantidades diferentes de ícone. -->
              <ItemsControl Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right"
                            ItemsSource="{Binding GitBadges}"
                            ItemTemplate="{StaticResource BadgeTemplate}"
                            ItemsPanel="{StaticResource BadgeRowPanel}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{DynamicResource Space.XXS}">
                <TextBlock Classes="cell body emphasized" Text="{Binding Name}" />
                <TextBlock Classes="cell subheadline muted" Text="{Binding Tags}"
                           ToolTip.Tip="{Binding TagsTooltip}"
                           IsVisible="{Binding Tags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>
            <TextBlock Grid.Column="1" Classes="cell callout mono" Text="{Binding Branch}" Margin="{DynamicResource Margin.BeforeColumn}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource Spacing.Related}">
              <!-- 50: largura do número do PR, para os ícones alinharem entre linhas. -->
              <TextBlock Classes="cell body" Width="50" Text="{Binding PullRequestLabel}"
                         ToolTip.Tip="{Binding PullRequestTooltip}" />
              <ItemsControl VerticalAlignment="Center"
                            ItemsSource="{Binding PullRequestBadges}"
                            ItemTemplate="{StaticResource BadgeTemplate}"
                            ItemsPanel="{StaticResource BadgeRowPanel}" />
            </StackPanel>

            <!-- Caminho sem monoespaçada: a Menlo, mais larga, cortaria o caminho cedo demais. -->
            <TextBlock Grid.Column="3" Classes="cell subheadline muted" Text="{Binding FullPath}"
                       ToolTip.Tip="{Binding FullPath}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Rodapé -->
    <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Separator}"
            Background="{DynamicResource Brush.Background.Window}" Padding="{DynamicResource Padding.Bar}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <!-- 80x4: tamanho do indicador de atividade, layout deste rodapé. -->
        <ProgressBar Grid.Column="0" Width="80" Height="4" IsIndeterminate="True"
                     VerticalAlignment="Center" Margin="{DynamicResource Margin.BeforeColumn}"
                     IsVisible="{Binding IsBusy}" />
        <TextBlock Grid.Column="1" Classes="callout muted" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="{Binding StatusMessage}" />
        <!-- Fica enquanto o monitoramento recua pela cota: a coluna PR parada não é travamento. -->
        <TextBlock Grid.Column="2" Classes="notice" Margin="{DynamicResource Margin.AroundColumn}"
                   Text="{Binding MonitorNotice}" IsVisible="{Binding HasMonitorNotice}"
                   ToolTip.Tip="A cota de consultas GraphQL do GitHub (5000/h, da conta inteira — outras ferramentas gastam dela também) passou de 60 %. Todas as cadências ficam mais longas até o reset ou até o consumo baixar." />
        <!-- Fica enquanto o FSEvents não subiu: a lista não acompanha o git na hora. -->
        <TextBlock Grid.Column="3" Classes="notice" Margin="{DynamicResource Margin.BeforeColumn}"
                   Text="{Binding WatcherNotice}" IsVisible="{Binding HasWatcherNotice}"
                   ToolTip.Tip="O acompanhamento do git dir (FSEvents) não ficou pronto a tempo — comum em disco externo ou máquina sob carga. A lista é relida periodicamente e o app tenta de novo; o Atualizar relê na hora." />
        <Button Grid.Column="4" Content="{Binding CleanupButtonLabel}" Margin="{DynamicResource Margin.BeforeButton}"
                Click="OnCleanupClick" IsEnabled="{Binding CanCleanupManually}"
                ToolTip.Tip="{Binding CleanupToolTip}" ToolTip.ShowOnDisabled="True" />
        <Button Grid.Column="5" Content="Abrir no iTerm2" Click="OnOpenTerminalClick"
                IsEnabled="{Binding SelectedWorktree, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </Border>

    </Grid>

    <!-- A fila do GitHub Actions (#130): global, não da aba — fica com a janela sem repositório
         também. A mesma view da janela própria; recolhido, não busca nada. 340: largura do
         painel, layout desta janela. -->
    <Border Grid.Column="1" Name="ActionsPanel" Width="340"
            BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Brush.Separator}"
            Background="{DynamicResource Brush.Background.Content}"
            DataContext="{Binding Actions}"
            IsVisible="{Binding IsPanelOpen}">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="{DynamicResource Padding.Bar}">
          <TextBlock Grid.Column="0" Classes="headline" VerticalAlignment="Center" Text="Fila do GitHub Actions" />
          <Button Grid.Column="1" Classes="borderless" Content="Destacar" Click="OnDetachActionsClick"
                  ToolTip.Tip="Abre a fila numa janela própria — para deixar num segundo monitor — e recolhe o painel. A janela continua aberta se o painel voltar ou for recolhido." />
          <Button Grid.Column="2" Classes="borderless" Click="OnCloseActionsPanelClick"
                  ToolTip.Tip="Recolher o painel (⇧⌘A). Recolhido, não consulta o GitHub.">
            <PathIcon Classes="small" Data="{StaticResource Icon.Close}" />
          </Button>
        </Grid>
        <views:ActionsQueueView Grid.Row="1" />
      </Grid>
    </Border>

    </Grid>

  </Grid>
</Window>
