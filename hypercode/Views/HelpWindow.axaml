<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hypercode.Views"
        x:Class="Hypercode.Views.HelpWindow"
        Title="Ajuda — Hypercode"
        Width="720" Height="680"
        MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.Window}">

  <Window.Styles>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title3}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="{DynamicResource Margin.Section}" />
    </Style>
    <Style Selector="TextBlock.p">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="{DynamicResource Margin.Paragraph}" />
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    </Style>
    <Style Selector="TextBlock.tag">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="{DynamicResource Margin.Term}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Label.Secondary}" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <DataTemplate x:Key="LegendTemplate">
      <!-- 28: calha do ícone da legenda, layout desta lista. -->
      <Grid ColumnDefinitions="28,*" Margin="{DynamicResource Margin.Paragraph}">
        <PathIcon Grid.Column="0"
                  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="{DynamicResource Margin.IconAlignTop}"
                  Data="{Binding IconKey, Converter={x:Static views:BadgeConverter.ToGeometry}}">
          <PathIcon.Foreground>
            <MultiBinding Converter="{x:Static views:BadgeBrushConverter.Instance}">
              <Binding Path="BrushKey" />
              <Binding Path="ActualThemeVariant" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
          </PathIcon.Foreground>
        </PathIcon>
        <StackPanel Grid.Column="1" Spacing="{DynamicResource Space.XXS}">
          <TextBlock Classes="body emphasized" Text="{Binding Title}" />
          <TextBlock Classes="body" Text="{Binding Description}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Label.Secondary}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="*,Auto" Margin="{DynamicResource Margin.Window}">
    <ScrollViewer Grid.Row="0">
      <!-- 600: largura máxima da linha de texto, para a leitura não ficar longa demais. -->
      <StackPanel MaxWidth="600" HorizontalAlignment="Left">

        <TextBlock Classes="h2" Margin="{DynamicResource Margin.Paragraph}" Text="Ícones — estado do worktree" />
        <ItemsControl ItemsSource="{Binding WorktreeLegend}" ItemTemplate="{StaticResource LegendTemplate}" />

        <TextBlock Classes="h2" Text="Ícones — pull request" />
        <ItemsControl ItemsSource="{Binding PullRequestLegend}" ItemTemplate="{StaticResource LegendTemplate}" />

        <TextBlock Classes="h2" Text="Ícones — abas" />
        <ItemsControl ItemsSource="{Binding TabLegend}" ItemTemplate="{StaticResource LegendTemplate}" />
        <TextBlock Classes="p" Text="Cada repositório aberto é uma aba, com o número de worktrees ao lado do nome. Todas continuam vivas em segundo plano: lista, monitoramento, notificações e limpeza automática rodam nas abas de trás também, na cadência de segundo plano. Aba + ou ⌘O abre outro repositório — a pasta de um worktree abre o repositório dono dele —, e dá para arrastar a pasta do Finder para a janela. ⌘1…⌘9 trocam de aba, arrastar muda a ordem e ⌘W fecha, com confirmação: fechar só para de monitorar, nada no disco é apagado." />

        <TextBlock Classes="h2" Text="Etiquetas abaixo do nome do worktree" />
        <TextBlock Classes="p muted"
                   Text="Vêm do git worktree list --porcelain e só aparecem quando se aplicam. Passar o mouse sobre elas na lista mostra a explicação da linha." />

        <TextBlock Classes="tag" Text="principal" />
        <TextBlock Classes="p" Text="É o worktree original do repositório, onde fica o diretório .git de verdade. Os demais são vinculados, criados com git worktree add. Este não pode ser removido com git worktree remove." />

        <TextBlock Classes="tag" Text="travado" />
        <TextBlock Classes="p" Text="Alguém rodou git worktree lock aqui. Há dois casos: lock manual (motivo em texto livre, ou sem motivo) protege o worktree e a limpeza não mexe — destrave pelo menu, em Destravar o worktree… Já ferramentas como o supacode gravam um JSON com owner no motivo e usam o lock só como marcador de propriedade; esse não protege, e a limpeza destrava sozinha antes de remover. O tooltip mostra qual é qual." />

        <TextBlock Classes="tag" Text="órfão" />
        <TextBlock Classes="p" Text="O git marcou como prunable: o ponteiro aponta para uma pasta que não existe mais, normalmente porque o diretório foi apagado na mão. Um git worktree prune limpa os metadados." />

        <TextBlock Classes="tag" Text="bare" />
        <TextBlock Classes="p" Text="Repositório sem árvore de trabalho — não há arquivos para abrir no terminal." />

        <TextBlock Classes="tag" Text="draft · merged · closed" />
        <TextBlock Classes="p" Text="Estado do PR da branch, mostrado quando ele não está simplesmente aberto. draft é um PR aberto como rascunho; merged foi integrado; closed foi fechado sem merge." />

        <TextBlock Classes="h2" Text="Coluna PR" />
        <TextBlock Classes="p" Text="Vem de gh pr list, casando o headRefName do PR com a branch do worktree. Havendo mais de um PR para a mesma branch, o app prefere o aberto, depois o mergeado, depois o fechado. Sem o gh instalado e autenticado a coluna fica vazia e o resto continua funcionando." />

        <TextBlock Classes="h2" Text="Limpar concluídos" />
        <TextBlock Classes="p" Text="Junta os worktrees cujo PR está merged ou closed, mais os órfãos e os de branch remota apagada (upstream gone) cujo HEAD já está contido na base remota — origin/HEAD, verificado com git merge-base --is-ancestor —, e remove com git worktree remove — sem --force. Isso é intencional: se houver alteração não commitada, o git recusa e o Hypercode informa em vez de apagar seu trabalho." />
        <TextBlock Classes="p" Text="A branch local não é tocada, só o worktree. O principal, os bare e os travados nunca entram. Órfãos são resolvidos com git worktree prune ao final." />
        <TextBlock Classes="p" Text="Branch remota apagada sem estar na base fica de fora: pode ter sido apagada sem merge. Squash e rebase merge reescrevem os commits, então o HEAD não aparece na base — nesses casos a limpeza depende de o PR ser encontrado." />
        <TextBlock Classes="p" Text="Antes de remover qualquer coisa, o app lista os candidatos e pede confirmação." />

        <TextBlock Classes="h2" Text="Limpeza automática" />
        <TextBlock Classes="p" Text="Opção das configurações, desligada por padrão. Ligada, o botão vira Limpeza automática e fica desabilitado: o monitor remove sozinho, pelo mesmo critério e sem --force, os concluídos que passaram da carência (10 min por padrão). O rodapé informa cada remoção e o tooltip do botão guarda o histórico da sessão." />
        <TextBlock Classes="p" Text="O git worktree remove apaga junto os arquivos ignorados pelo .gitignore — .env, appsettings.Development.json, banco local. Sem um humano lendo a lista, a limpeza automática pula o worktree que tem arquivo ignorado fora de bin/ e obj/, o que tem um terminal ou processo aberto dentro (lsof) e o travado, inclusive por ferramenta — esses ficam listados no tooltip, para o menu Apagar o worktree…. Com a janela minimizada, pausa." />

        <TextBlock Classes="h2" Text="Fila do GitHub Actions" />
        <TextBlock Classes="p" Text="O botão de colunas na barra (⇧⌘A) abre, ao lado da lista, os runners self-hosted da organização dos repositórios escolhidos nas configurações — por grupo, ocupado, livre ou offline, e o job que cada ocupado roda quando é de um repositório acompanhado — e o que espera por eles, uma fila por conjunto de labels. Destacar leva a mesma view para uma janela própria, para deixar num segundo monitor." />
        <TextBlock Classes="p" Text="A ordem da fila é estimada pelo horário de entrada: o GitHub não expõe posição, e jobs de repositórios não acompanhados disputam os mesmos runners sem aparecer. Job que espera um needs nem chega à API, então o que está na fila espera mesmo um runner. Anda na cadência do monitoramento e recua pela cota REST; recolhido e com a janela fechada, não consulta nada. Ver os runners pede o escopo admin:org no gh; sem ele, a fila continua." />
        <TextBlock Classes="p" Text="Clique direito num runner ocupado, num job da fila ou num run sem job: Cancelar o run inteiro… e Forçar cancelamento…, cada um com confirmação. O GitHub só cancela o run todo — não existe cancelar um job sozinho. Forçar pula os passos com if: always() e a limpeza do workflow; é para o run que não para com o cancelamento comum. Depois do pedido, o painel relê em poucos segundos. Sem escrita no repositório, ou com o token do gh sem o escopo repo, os itens aparecem desabilitados com o motivo." />
        <TextBlock Classes="p" Text="Reordenar a fila não existe: a API do GitHub não tem prioridade nem posição. O único jeito de alguém entrar antes é cancelar o que está na frente." />

        <TextBlock Classes="h2" Text="Grafo de issues" />
        <TextBlock Classes="p" Text="Opção das configurações, desligada por padrão. Ligada, o botão de grafo na barra (⇧⌘G) abre as issues abertas do repositório da aba: a lista ordenada por quantas issues cada uma destrava, somando todos os níveis de Blocked by / Blocking, com livre (sem bloqueador aberto) ou presa por N; e o grafo em camadas, em que cada coluna é um nível de dependência a mais. Filtros de milestone, label e tipo — o de tipo some sem tipos na organização." />
        <TextBlock Classes="p" Text="Clicar num cartão isola o que o segura e o que ele destrava; Ver tudo ou Esc volta. Duplo-clique abre a issue no navegador. Bloqueador fechado aparece apagado e não segura mais; o de outro repositório vira um cartão cinza. Ciclo de dependência vira aviso. Lê o GitHub ao abrir e ao trocar de aba, uma consulta GraphQL por 50 issues; recolhido ou desligado, não lê nada." />
        <TextBlock Classes="p" Text="Clique direito numa linha da lista ou num cartão: Focar no grafo, Abrir no navegador e Criar worktree para esta issue, que abre o Novo worktree já com o número, o título e a branch sugerida. O grafo fica como estava, para seguir escolhendo. Issue de outro repositório tem o item desabilitado: o worktree é deste." />

        <TextBlock Classes="h2" Text="Abrir no terminal" />
        <TextBlock Classes="p" Text="Duplo-clique ou Enter abre uma janela nova do terminal na pasta do worktree e roda o Comando das configurações, ⌘, (por padrão claude). O terminal também se escolhe lá: iTerm2, Terminal.app, Ghostty, WezTerm, Alacritty ou kitty, entre os instalados. No padrão do sistema, o iTerm2 se instalado e, senão, o Terminal.app. Na primeira vez o macOS pede permissão de automação; com o worktree num disco externo, o terminal escolhido também precisa da de Volumes removíveis." />
        <TextBlock Classes="p" Text="Se o worktree já tem terminal aberto — o ícone de terminal na linha —, o duplo-clique e o Enter trazem esse terminal para a frente em vez de abrir outro; havendo vários, o mais recente. Funciona com o iTerm2 e com o Terminal.app; os demais terminais não expõem as janelas, e com eles o duplo-clique sempre abre uma nova. Para abrir outro de propósito, use Abrir no terminal rodando o comando ou Abrir o terminal, no menu de contexto; Ir para o terminal aberto faz só o foco." />

      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="1" Content="Fechar" HorizontalAlignment="Right" Margin="{DynamicResource Margin.DialogButtons}"
            Click="OnClose" IsDefault="True" IsCancel="True" />
  </Grid>
</Window>
