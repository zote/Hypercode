<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hypercode.Views"
        x:Class="Hypercode.Views.ActionsQueueWindow"
        Title="Fila do GitHub Actions"
        Width="420" Height="640"
        MinWidth="320" MinHeight="300"
        Background="{DynamicResource Brush.Background.Content}">

  <!-- O painel destacado (#130): a mesma ActionsQueueView da janela principal, com o mesmo
       DataContext. Sem dono: fica num segundo monitor sem flutuar sobre a principal nem
       minimizar junto com ela. 420x640: tamanho inicial, layout desta janela. -->
  <views:ActionsQueueView />
</Window>
