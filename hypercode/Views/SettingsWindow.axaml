<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hypercode.Views.SettingsWindow"
        Title="Configurações"
        Width="560" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.Window}">

  <!-- DataContext é o SettingsViewModel: cada campo grava no settings.json assim que muda, e as
       abas reagem na hora. Por isso não há botão nenhum, como nos Ajustes do macOS: fecha pelo
       botão da janela, ⌘W ou Esc. -->
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.help">
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Callout}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Label.Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Marca de campo sobrescrito no repositório do escopo. -->
    <Style Selector="TextBlock.overridden">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Subheadline}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Text" Value="● sobrescrito neste repositório" />
    </Style>
    <!-- "Usar o global", à direita do título de cada campo, só no escopo de um repositório. -->
    <Style Selector="CheckBox.inherit">
      <Setter Property="FontSize" Value="{DynamicResource Font.Size.Callout}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Content" Value="Usar o global" />
    </Style>
    <!-- Cada ajuste: título (com a marca e o "usar o global"), o controle e a explicação. -->
    <Style Selector="StackPanel.setting">
      <Setter Property="Spacing" Value="{DynamicResource Spacing.Label}" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="{DynamicResource Margin.Window}" Spacing="{DynamicResource Spacing.Group}">

    <!-- Escopo -->
    <StackPanel Classes="setting">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Classes="label" Text="Valem para" Margin="{DynamicResource Margin.BeforeColumn}" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope, Mode=TwoWay}" />
      </Grid>
      <TextBlock Classes="help" Text="{Binding ScopeHint}" />
    </StackPanel>

    <Separator />

    <StackPanel Classes="setting">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="label" Text="Comando" />
        <TextBlock Grid.Column="1" Classes="overridden" Margin="{DynamicResource Margin.AfterField}" IsVisible="{Binding IsCommandOverridden}" />
        <CheckBox Grid.Column="2" Classes="inherit" IsChecked="{Binding CommandUsesGlobal, Mode=TwoWay}"
                  IsVisible="{Binding IsRepositoryScope}" />
      </Grid>
      <TextBox Name="CommandBox" Text="{Binding Command, Mode=TwoWay}" Watermark="claude"
               IsEnabled="{Binding CanEditCommand}" />
      <TextBlock Classes="help"
                 Text="O que o duplo-clique (ou Enter) roda na janela nova do terminal, dentro do worktree. Vazio volta a ser claude." />
    </StackPanel>

    <!-- Só no global: o terminal é da máquina, não do repositório. -->
    <StackPanel Classes="setting" IsVisible="{Binding !IsRepositoryScope}">
      <TextBlock Classes="label" Text="Terminal" />
      <ComboBox HorizontalAlignment="Stretch"
                ItemsSource="{Binding TerminalOptions}" SelectedItem="{Binding SelectedTerminal, Mode=TwoWay}" />
      <TextBlock Classes="help" Foreground="{DynamicResource Brush.Text.Warning}"
                 Text="{Binding TerminalNotice}"
                 IsVisible="{Binding TerminalNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="help" Text="{Binding TerminalHint}" />
    </StackPanel>

    <StackPanel Classes="setting">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="label" Text="Monitoramento do GitHub" />
        <TextBlock Grid.Column="1" Classes="overridden" Margin="{DynamicResource Margin.AfterField}" IsVisible="{Binding IsMonitorProfileOverridden}" />
        <CheckBox Grid.Column="2" Classes="inherit" IsChecked="{Binding MonitorProfileUsesGlobal, Mode=TwoWay}"
                  IsVisible="{Binding IsRepositoryScope}" />
      </Grid>
      <!-- 200: largura mínima do combo, para os quatro perfis caberem sem cortar. -->
      <ComboBox MinWidth="200" SelectedIndex="{Binding MonitorProfileIndex, Mode=TwoWay}"
                IsEnabled="{Binding CanEditMonitorProfile}">
        <ComboBoxItem Content="Desligado" />
        <ComboBoxItem Content="Econômico" />
        <ComboBoxItem Content="Equilibrado" />
        <ComboBoxItem Content="Agressivo" />
      </ComboBox>
      <TextBlock Classes="help"
                 Text="Quão atento o app fica ao GitHub. Cada worktree tem a sua cadência, pelo estado do PR — de 30 s com a CI rodando a 30 min na branch nunca pushada —, e o perfil multiplica todas: econômico 2×, equilibrado 1×, agressivo ½. Em segundo plano — janela sem foco ou aba de trás —, o triplo; minimizado, pausa." />
    </StackPanel>

    <StackPanel Classes="setting">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Spacing.Related}">
          <CheckBox IsChecked="{Binding NotifyPullRequestChanges, Mode=TwoWay}" IsEnabled="{Binding CanEditNotify}"
                    Content="Notificar quando um PR mudar" />
          <TextBlock Classes="overridden" IsVisible="{Binding IsNotifyOverridden}" />
        </StackPanel>
        <CheckBox Grid.Column="1" Classes="inherit" IsChecked="{Binding NotifyUsesGlobal, Mode=TwoWay}"
                  IsVisible="{Binding IsRepositoryScope}" />
      </Grid>
      <TextBlock Classes="help"
                 Text="Notificação do macOS quando o monitoramento vê checks, review, merge ou conflito mudarem, começando pelo nome do repositório. Desligada, a linha e a aba continuam com o sino." />
    </StackPanel>

    <StackPanel Classes="setting">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Spacing.Related}">
          <CheckBox IsChecked="{Binding AssignIssueOnCreate, Mode=TwoWay}" IsEnabled="{Binding CanEditAssignIssue}"
                    Content="Atribuir a issue a mim ao criar o worktree a partir dela" />
          <TextBlock Classes="overridden" IsVisible="{Binding IsAssignIssueOverridden}" />
        </StackPanel>
        <CheckBox Grid.Column="1" Classes="inherit" IsChecked="{Binding AssignIssueUsesGlobal, Mode=TwoWay}"
                  IsVisible="{Binding IsRepositoryScope}" />
      </Grid>
      <TextBlock Classes="help"
                 Text="Se o usuário do gh não estiver entre os assignees, o app o acrescenta (gh issue edit --add-assignee @me); quem já estava continua. É a única opção que escreve no GitHub. Se o GitHub recusar, o worktree é criado do mesmo jeito e o motivo aparece no rodapé." />
    </StackPanel>

    <StackPanel Classes="setting">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="label" Text="Pasta dos worktrees" />
        <TextBlock Grid.Column="1" Classes="overridden" Margin="{DynamicResource Margin.AfterField}" IsVisible="{Binding IsWorktreesRootOverridden}" />
        <CheckBox Grid.Column="2" Classes="inherit" IsChecked="{Binding WorktreesRootUsesGlobal, Mode=TwoWay}"
                  IsVisible="{Binding IsRepositoryScope}" />
      </Grid>
      <TextBox Text="{Binding WorktreesRoot, Mode=TwoWay}" Watermark="../{repo}.worktrees"
               FontFamily="{DynamicResource Font.Mono}" IsEnabled="{Binding CanEditWorktreesRoot}" />
      <TextBlock Classes="help" Text="{Binding WorktreesRootPreview}"
                 IsVisible="{Binding WorktreesRootPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="help"
                 Text="Onde o Novo worktree sugere a pasta: caminho absoluto (/Volumes/dev/repo-worktrees, ~/wt) ou relativo à raiz do repositório (.claude/worktrees); {repo} vira o nome do repositório. Vazio, repo.worktrees ao lado do repositório. Sem nada configurado, a sugestão segue onde a maioria dos worktrees já mora. Dentro do repositório, a pasta precisa estar no .gitignore ou no .git/info/exclude — o diálogo avisa se não estiver." />
    </StackPanel>

    <StackPanel Classes="setting">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Spacing.Related}">
          <CheckBox IsChecked="{Binding KeepSlashes, Mode=TwoWay}" IsEnabled="{Binding CanEditKeepSlashes}"
                    Content="Prefixo da branch vira subpasta" />
          <TextBlock Classes="overridden" IsVisible="{Binding IsKeepSlashesOverridden}" />
        </StackPanel>
        <CheckBox Grid.Column="1" Classes="inherit" IsChecked="{Binding KeepSlashesUsesGlobal, Mode=TwoWay}"
                  IsVisible="{Binding IsRepositoryScope}" />
      </Grid>
      <TextBlock Classes="help"
                 Text="feat/476-anexo fica em feat/476-anexo, uma pasta por prefixo. Desligado, a barra vira hífen: feat-476-anexo, uma pasta só por worktree." />
    </StackPanel>

    <StackPanel Classes="setting">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Spacing.Label}">
          <!-- IsChecked só de ida: ligar passa pelo aviso no Click, que é quem grava. -->
          <CheckBox Name="AutoCleanupBox" IsChecked="{Binding AutoCleanup, Mode=OneWay}"
                    IsEnabled="{Binding CanEditAutoCleanup}"
                    Click="OnAutoCleanupClick" Content="Limpeza automática dos concluídos" />
          <Button Classes="borderless" VerticalAlignment="Center" Click="OnAutoCleanupInfoClick"
                  ToolTip.Tip="Reler o aviso: o que o git apaga junto e o que fica de fora">
            <PathIcon Data="{StaticResource Icon.Info}" />
          </Button>
          <TextBlock Classes="overridden" IsVisible="{Binding IsAutoCleanupOverridden}" />
        </StackPanel>
        <CheckBox Grid.Column="1" Classes="inherit" IsChecked="{Binding AutoCleanupUsesGlobal, Mode=TwoWay}"
                  IsVisible="{Binding IsRepositoryScope}"
                  ToolTip.Tip="A limpeza automática e a carência dela são sobrescritas juntas." />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.Related}" IsEnabled="{Binding CanEditAutoCleanupGrace}">
        <TextBlock Text="Remover" VerticalAlignment="Center" />
        <!-- 120: largura do campo de minutos, cabe 1440 com as setas. -->
        <NumericUpDown Value="{Binding AutoCleanupGraceMinutes, Mode=TwoWay}" Minimum="1" Maximum="1440"
                       Increment="1" FormatString="0" Width="120" />
        <TextBlock Text="min depois de concluído" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="help"
                 Text="Sem confirmação: o monitor remove os concluídos passada a carência, e o botão do rodapé vira Limpeza automática, com o histórico no tooltip. Roda em todas as abas em que estiver ligada, inclusive as de trás. Pula os travados, os que têm um terminal aberto dentro e os que têm arquivo ignorado fora de bin/ e obj/ (.env, appsettings.Development.json) — o git os apagaria junto. Minimizado, pausa." />
    </StackPanel>

    <!-- Só no global: os runners são da organização, e a fila não é de uma aba. -->
    <StackPanel Classes="setting" IsVisible="{Binding !IsRepositoryScope}">
      <TextBlock Classes="label" Text="Fila do GitHub Actions" />
      <!-- Grava ao sair do campo, não a cada tecla: um nome pela metade viraria uma leitura que dá 404.
           O Closing da janela grava o que ainda estiver no campo. 72: três linhas à vista. -->
      <TextBox Name="ActionsRepositoriesBox"
               Text="{Binding ActionsRepositoriesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
               AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="72"
               Watermark="owner/repo — um por linha" FontFamily="{DynamicResource Font.Mono}" />
      <TextBlock Classes="help" Foreground="{DynamicResource Brush.Text.Warning}"
                 Text="{Binding ActionsRepositoriesIgnored}"
                 IsVisible="{Binding ActionsRepositoriesIgnored, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="help"
                 Text="Os repositórios cuja fila o painel do Actions acompanha (botão da barra, ⇧⌘A). Os runners são da organização e todos os repositórios dela disputam os mesmos, mas não há endpoint de fila da org inteira: varrer todos estoura a cota. Escolha os que importam — cada um custa ~3 chamadas por ciclo, na cadência do monitoramento. Aceita owner/repo ou a URL do GitHub." />
    </StackPanel>

    <!-- Só no global: o painel é da janela e segue a aba da frente. -->
    <StackPanel Classes="setting" IsVisible="{Binding !IsRepositoryScope}">
      <CheckBox Name="IssueGraphBox" IsChecked="{Binding IssueGraphEnabled, Mode=TwoWay}" Content="Grafo de issues do repositório" />
      <TextBlock Classes="help"
                 Text="Botão na barra (⇧⌘G) com as issues abertas do repositório da aba: quais estão livres — sem bloqueador aberto — e quantas cada uma destrava, somando todos os níveis de Blocked by / Blocking. Lista por impacto e grafo em camadas, com filtro de milestone, label e tipo. Lê o GitHub ao abrir o painel e ao trocar de aba (~2 pontos da cota GraphQL a cada 50 issues). Desligado, nada é lido." />
    </StackPanel>

  </StackPanel>
</Window>
