<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hypercode.Views"
        x:Class="Hypercode.Views.IssueGraphWindow"
        Title="Grafo de issues"
        Width="960" Height="680"
        MinWidth="420" MinHeight="320"
        Background="{DynamicResource Brush.Background.Content}">

  <!-- O grafo destacado (#144): a mesma IssueGraphView do painel, com o mesmo DataContext. Sem
       dono, como a janela da fila do Actions. 960x680: tamanho inicial, com lugar para umas
       quatro colunas de cartões. -->
  <views:IssueGraphView />
</Window>
