<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hypercode.Views"
        x:Class="Hypercode.Views.UpdateFromBaseWindow"
        Title="Atualizar a partir da base"
        Width="620" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.Window}">

  <!-- Layout de diálogo da HIG (Styles/Dialog.axaml). Merge é o padrão: não reescreve nada
       já pushado. Rebase é a alternativa, e por isso fica à esquerda do Cancelar. -->
  <views:DialogFrame Name="Frame">
    <StackPanel Spacing="{DynamicResource Spacing.Related}">
      <Border BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Separator}"
              Background="{DynamicResource Brush.Background.Content}"
              CornerRadius="{DynamicResource Radius.Control}"
              Padding="{DynamicResource Padding.Box}">
        <TextBlock Name="DetailText" Classes="callout mono" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Label.Primary}" />
      </Border>

      <StackPanel Spacing="{DynamicResource Space.XXS}">
        <TextBlock Classes="body emphasized" Text="Merge" />
        <TextBlock Name="MergeText" Classes="body" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Label.Secondary}" />
      </StackPanel>

      <StackPanel Spacing="{DynamicResource Space.XXS}">
        <TextBlock Classes="body emphasized" Text="Rebase" />
        <TextBlock Name="RebaseText" Classes="body" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Label.Secondary}" />
      </StackPanel>
    </StackPanel>

    <views:DialogFrame.Buttons>
      <Button Content="Rebase" Click="OnRebase" />
      <Button Content="Cancelar" Click="OnCancel" IsCancel="True" />
      <Button Content="Merge" Click="OnMerge" IsDefault="True" />
    </views:DialogFrame.Buttons>
  </views:DialogFrame>
</Window>
