<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hypercode.Views.AboutWindow"
        Title="Sobre o Hypercode"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="28,28,28,20" Spacing="6" HorizontalAlignment="Center">
    <Image Source="avares://Hypercode/Assets/icon.png" Width="96" Height="96"
           HorizontalAlignment="Center" Margin="0,0,0,8" />

    <TextBlock Text="Hypercode" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
    <TextBlock Name="VersionText" Opacity="0.6" HorizontalAlignment="Center" />

    <TextBlock Text="Os worktrees do repositório, o estado de cada um e o atalho para abrir o Claude neles."
               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />

    <Button Content="github.com/zote/Hypercode" Click="OnRepositoryClick"
            HorizontalAlignment="Center" Margin="0,6,0,0"
            Background="Transparent" Foreground="{DynamicResource SystemAccentColor}" />

    <TextBlock Text="Feito com Avalonia." FontSize="11" Opacity="0.45"
               HorizontalAlignment="Center" Margin="0,10,0,0" />

    <Button Content="Fechar" Click="OnClose"
            HorizontalAlignment="Center" Margin="0,14,0,0" />
  </StackPanel>
</Window>
