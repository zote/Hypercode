<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hypercode.Views.AboutWindow"
        Title="Sobre o Hypercode"
        Width="340" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.Window}">

  <!-- Painel Sobre do macOS: ícone, nome, versão e as linhas de crédito, centralizados e sem
       botão — fecha pelo botão da janela, ⌘W ou Esc. -->
  <StackPanel Margin="{DynamicResource Margin.Window}" Spacing="{DynamicResource Space.XS}" HorizontalAlignment="Center">
    <!-- 96: tamanho do ícone do app no painel. -->
    <Image Source="avares://Hypercode/Assets/icon.png" Width="96" Height="96"
           HorizontalAlignment="Center" Margin="{DynamicResource Margin.Paragraph}" />

    <TextBlock Classes="title3 emphasized" Text="Hypercode" HorizontalAlignment="Center" />
    <TextBlock Name="VersionText" Classes="subheadline" HorizontalAlignment="Center"
               Foreground="{DynamicResource Brush.Label.Secondary}" />

    <TextBlock Classes="callout" Margin="{DynamicResource Margin.Section}"
               Text="Os worktrees do repositório, o estado de cada um e o atalho para abrir o Claude neles."
               TextWrapping="Wrap" TextAlignment="Center" />

    <Button Classes="borderless" Content="github.com/zote/Hypercode" Click="OnRepositoryClick"
            HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text.Link}" />

    <TextBlock Classes="footnote" Text="Feito com Avalonia." HorizontalAlignment="Center"
               Foreground="{DynamicResource Brush.Label.Secondary}" />
  </StackPanel>
</Window>
