<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hypercode.Views"
        x:Class="Hypercode.Views.LockWorktreeWindow"
        Title="Travar o worktree"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.Window}">

  <!-- Layout de diálogo da HIG (Styles/Dialog.axaml). Return no campo também trava. -->
  <views:DialogFrame Name="Frame"
                     Message="Com a trava, o git recusa remover e podar o worktree, e a limpeza de concluídos o ignora.">
    <TextBox Name="ReasonBox" Watermark="Motivo (opcional)" KeyDown="OnReasonKeyDown" />

    <views:DialogFrame.Buttons>
      <Button Content="Cancelar" Click="OnCancel" IsCancel="True" />
      <Button Name="ConfirmButton" Content="Travar" Click="OnConfirm" IsDefault="True" />
    </views:DialogFrame.Buttons>
  </views:DialogFrame>
</Window>
