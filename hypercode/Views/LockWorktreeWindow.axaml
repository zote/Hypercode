<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hypercode.Views.LockWorktreeWindow"
        Title="Travar o worktree"
        Width="520" SizeToContent="Height"
        MinWidth="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="12">
    <TextBlock Name="HeadlineText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />

    <TextBlock Text="Com a trava, o git recusa remover e podar o worktree, e a limpeza de concluídos o ignora."
               FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

    <TextBox Name="ReasonBox" Watermark="Motivo (opcional)" KeyDown="OnReasonKeyDown" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
      <Button Content="Cancelar" Click="OnCancel" IsCancel="True" />
      <Button Name="ConfirmButton" Content="Travar" Click="OnConfirm" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
