<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\hypercode\Hypercode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TokensTests, FluentOverridesTests e IconsTests leem o XAML para conferir contraste, paridade das
         variantes e os aliases das chaves do Fluent; IconsTests lê também o gerador e a galeria -->
    <None Include="..\..\hypercode\Styles\Tokens.axaml" Link="Tokens.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\hypercode\Styles\FluentOverrides.axaml" Link="FluentOverrides.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\hypercode\Styles\Icons.axaml" Link="Icons.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\hypercode\Styles\tools\gen_icons.py" Link="gen_icons.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\hypercode\Views\ControlGallerySample.axaml" Link="ControlGallerySample.axaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
